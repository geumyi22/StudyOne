<Window x:Class="StudyOne.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudyOne 3.1.0-canary.6 · Windows Preview" Width="1200" Height="820"
        MinWidth="920" MinHeight="660" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Background="#F3F6FC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="0,5,10,3"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="0,5,10,3"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F6F8FC"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#151D35" CornerRadius="16" Padding="22" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="StudyOne" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="AI 학습 관리 플랫폼 · Windows 개발 프리뷰"
                               FontSize="12" Foreground="#CFD6EF" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="CANARY · LOCAL ONLY" FontSize="11"
                               FontWeight="SemiBold" Foreground="#A5D1FF" TextAlignment="Right"/>
                    <TextBlock x:Name="HeaderStatus" Text="데이터 확인 중" FontSize="12"
                               Foreground="White" TextAlignment="Right" Margin="0,8,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl Grid.Row="1" Background="White" FontSize="14">
            <TabItem Header="일정 · 숙제">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TasksSummary" Text="학교·학원 숙제와 날짜별 공부 계획"
                                   FontSize="14" Foreground="#53617B" Margin="0,8,0,5"/>
                        <WrapPanel Margin="0,3,0,9" VerticalAlignment="Center">
                            <TextBlock Text="일정 표시" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="TaskDateFilterCombo" Width="210" Margin="0,0,12,0"
                                      SelectionChanged="TaskDateFilter_SelectionChanged"
                                      ToolTip="오늘·이월, 내일 마감, 전체 일정 중 선택">
                                <ComboBoxItem Content="오늘 + 미완료 이월"/>
                                <ComboBoxItem Content="내일 마감"/>
                                <ComboBoxItem Content="전체 일정"/>
                            </ComboBox>
                            <TextBlock Text="내일 숙제도 오늘부터 미리 완료할 수 있습니다."
                                       FontSize="12" Foreground="#596B8B"
                                       VerticalAlignment="Center"/>
                        </WrapPanel>
                        <Button Content="오늘 할꺼 · 과목명 포함 목록 복사" Click="CopyToday_Click"
                                HorizontalAlignment="Left" Margin="0,0,0,7"/>
                    </StackPanel>
                    <DataGrid x:Name="TasksGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionChanged="TasksGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="날짜" Binding="{Binding DueDate}" Width="110"/>
                            <DataGridTextColumn Header="분류" Binding="{Binding Type}" Width="175"/>
                            <DataGridTextColumn Header="과목" Binding="{Binding Subject}" Width="105"/>
                            <DataGridTextColumn Header="할 일" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="중요도" Binding="{Binding Importance}" Width="74"/>
                            <DataGridTemplateColumn Header="완료 체크" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Completed, Mode=OneWay}"
                                                  Content="완료" Click="ToggleTaskRow_Click"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Background="#F5F7FC" CornerRadius="12" Padding="15">
                        <StackPanel>
                            <TextBlock Text="일정 추가 · 선택 항목 수정" FontWeight="SemiBold" FontSize="15" Foreground="#243351"/>
                            <WrapPanel Margin="0,8,0,8">
                                <StackPanel Width="180">
                                    <TextBlock Text="분류" FontSize="12" Foreground="#51627C"/>
                                    <ComboBox x:Name="TaskTypeCombo"/>
                                </StackPanel>
                                <StackPanel Width="125">
                                    <TextBlock Text="과목" FontSize="12" Foreground="#51627C"/>
                                    <TextBox x:Name="TaskSubjectInput"/>
                                </StackPanel>
                                <StackPanel Width="300">
                                    <TextBlock Text="할 일" FontSize="12" Foreground="#51627C"/>
                                    <TextBox x:Name="TaskTitleInput"/>
                                </StackPanel>
                                <StackPanel Width="145">
                                    <TextBlock Text="날짜" FontSize="12" Foreground="#51627C"/>
                                    <DatePicker x:Name="TaskDuePicker" Margin="0,5,10,3" MinHeight="32"/>
                                </StackPanel>
                                <StackPanel Width="85">
                                    <TextBlock Text="중요도" FontSize="12" Foreground="#51627C"/>
                                    <ComboBox x:Name="TaskImportanceCombo"/>
                                </StackPanel>
                                <StackPanel Width="80">
                                    <TextBlock Text="상태" FontSize="12" Foreground="#51627C"/>
                                    <CheckBox x:Name="TaskCompletedCheck" Content="완료" Margin="0,13,0,0"/>
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="저장" Click="SaveTask_Click"/>
                                <Button Content="새 항목" Click="ClearTask_Click"/>
                                <Button Content="선택 항목 삭제" Click="DeleteTask_Click"/>
                            </StackPanel>
                            <Separator Margin="0,12,0,10"/>
                            <TextBlock Text="선택 일정의 학습 상세 · 별도 로컬 저장" FontWeight="SemiBold"
                                       FontSize="14" Foreground="#243351"/>
                            <TextBlock Text="기존 일정·진도 JSON과 서버 동기화에는 포함되지 않습니다."
                                       Foreground="#64748B" FontSize="12" Margin="0,4,0,7"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="예상 시간(분)" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="TaskDetailMinutesInput" Width="90" MaxLength="3"
                                         ToolTip="1~600, 비워둘 수 있음"/>
                            </StackPanel>
                            <TextBlock Text="공부 단계 · 한 줄에 하나씩 (최대 20개 / 각 200자)"
                                       FontSize="12" Foreground="#51627C"/>
                            <TextBox x:Name="TaskDetailStepsInput" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                     Height="65" MaxLength="4200" Margin="0,3,0,7"/>
                            <TextBlock Text="완료 기준 (최대 500자)" FontSize="12" Foreground="#51627C"/>
                            <TextBox x:Name="TaskDetailCriteriaInput" TextWrapping="Wrap"
                                     AcceptsReturn="True" MaxLength="500" Height="48" Margin="0,3,0,7"/>
                            <Button Content="선택 일정의 학습 상세 저장" Click="SaveTaskDetail_Click"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="오답 · 복습">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="틀린 문제 · 정답 근거 · 복습 일정" FontSize="22"
                                   FontWeight="Bold" Foreground="#243351"/>
                        <TextBlock x:Name="WrongSummary" Text="오답 기록은 기기 로컬에만 저장됩니다."
                                   FontSize="13" Foreground="#53617B" Margin="0,8,0,5"/>
                        <TextBlock Text="기존 일정, 진도, AI 서버와 분리 · 자동 동기화되지 않습니다."
                                   Foreground="#64748B" FontSize="12" Margin="0,0,0,8"/>
                    </StackPanel>
                    <DataGrid x:Name="WrongGrid" Grid.Row="1" SelectionChanged="WrongGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="과목" Binding="{Binding Subject}" Width="110"/>
                            <DataGridTextColumn Header="교재" Binding="{Binding Material}" Width="140"/>
                            <DataGridTextColumn Header="틀린 문제·개념" Binding="{Binding Topic}" Width="*"/>
                            <DataGridTextColumn Header="복습일" Binding="{Binding NextReview}" Width="110"/>
                            <DataGridTextColumn Header="재풀이" Binding="{Binding Retries}" Width="75"/>
                            <DataGridCheckBoxColumn Header="숙달" Binding="{Binding Mastered}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Background="#F5F7FC" CornerRadius="12" Padding="15">
                        <StackPanel>
                            <TextBlock Text="오답 추가 · 수정" FontWeight="SemiBold" FontSize="15"/>
                            <WrapPanel Margin="0,8,0,8">
                                <StackPanel Width="120">
                                    <TextBlock Text="과목" FontSize="12"/>
                                    <TextBox x:Name="WrongSubjectInput" MaxLength="60"/>
                                </StackPanel>
                                <StackPanel Width="170">
                                    <TextBlock Text="교재" FontSize="12"/>
                                    <TextBox x:Name="WrongMaterialInput" MaxLength="120"/>
                                </StackPanel>
                                <StackPanel Width="245">
                                    <TextBlock Text="틀린 문제·개념" FontSize="12"/>
                                    <TextBox x:Name="WrongTopicInput" MaxLength="500"/>
                                </StackPanel>
                                <StackPanel Width="235">
                                    <TextBlock Text="틀린 이유·정답 근거" FontSize="12"/>
                                    <TextBox x:Name="WrongCorrectionInput" MaxLength="1000"/>
                                </StackPanel>
                                <StackPanel Width="145">
                                    <TextBlock Text="다음 복습일" FontSize="12"/>
                                    <DatePicker x:Name="WrongReviewPicker" Margin="0,5,10,3"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="오답 저장" Click="SaveWrong_Click"/>
                                <Button Content="새 오답" Click="ClearWrong_Click"/>
                                <Button Content="재풀이 성공 (+1)" Click="RetryWrong_Click"/>
                                <Button Content="숙달 상태 전환" Click="MasterWrong_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="쓰기 수행 연습">
                <ScrollViewer>
                    <StackPanel Margin="28" MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="영어 쓰기 수행평가 · 문장 암기 테스트"
                                   FontSize="22" FontWeight="Bold" Foreground="#243351"/>
                        <TextBlock Text="문장을 입력하고 가린 후 기억나는 문장을 써보세요. 문장은 저장하거나 AI·서버에 전송하지 않습니다."
                                   TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,18"/>
                        <TextBlock Text="암기할 문장" FontWeight="SemiBold"/>
                        <TextBox x:Name="WritingTargetInput" Height="88" AcceptsReturn="True"
                                 MaxLength="1500" TextWrapping="Wrap"/>
                        <Button Content="정답 가리고 시작" Click="WritingStart_Click" Width="175"
                                HorizontalAlignment="Left" Margin="0,10,0,14"/>
                        <TextBlock Text="암기한 문장 입력" FontWeight="SemiBold"/>
                        <TextBox x:Name="WritingAttemptInput" Height="105" AcceptsReturn="True"
                                 TextWrapping="Wrap" MaxLength="1500"/>
                        <WrapPanel Margin="0,12,0,12">
                            <Button Content="채점하기" Click="WritingCheck_Click"/>
                            <Button Content="다음 문장" Click="WritingReset_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="WritingResultText" TextWrapping="Wrap" FontSize="14"
                                   Foreground="#243351"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="교재 · 진도">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ProgressSummary" Text="시험범위 진도 관리"
                                   FontSize="14" Foreground="#53617B" Margin="0,8,0,8"/>
                        <ProgressBar x:Name="ExamProgressBar" Height="9" Minimum="0" Maximum="100" Value="0"/>
                        <Button Content="과목명 포함 진도 체크리스트 복사" Click="CopyProgress_Click"
                                HorizontalAlignment="Left" Margin="0,7,0,7"/>
                        <Button Content="+ 6과목 온라인 내신 문제 빠른 추가" Click="QuickAddOnlinePractice_Click"
                                HorizontalAlignment="Left" Margin="0,4,0,7"/>
                    </StackPanel>
                    <DataGrid x:Name="ProgressGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionChanged="ProgressGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="과목" Binding="{Binding Subject}" Width="130"/>
                            <DataGridTextColumn Header="교재" Binding="{Binding Material}" Width="175"/>
                            <DataGridTextColumn Header="진도 · 문제 · 오답" Binding="{Binding Unit}" Width="*"/>
                            <DataGridTextColumn Header="진행 상태" Binding="{Binding Status}" Width="110"/>
                            <DataGridTemplateColumn Header="완료 체크" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}"
                                                  Content="완료" Click="ToggleProgressRow_Click"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="시험범위" Binding="{Binding InExamScope}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Background="#F5F7FC" CornerRadius="12" Padding="15">
                        <StackPanel>
                            <TextBlock Text="교재·시험범위 진도 추가 · 수정" FontWeight="SemiBold" FontSize="15" Foreground="#243351"/>
                            <WrapPanel Margin="0,8,0,8">
                                <StackPanel Width="130">
                                    <TextBlock Text="과목" FontSize="12" Foreground="#51627C"/>
                                    <TextBox x:Name="ProgressSubjectInput"/>
                                </StackPanel>
                                <StackPanel Width="180">
                                    <TextBlock Text="교재" FontSize="12" Foreground="#51627C"/>
                                    <TextBox x:Name="ProgressMaterialInput"/>
                                </StackPanel>
                                <StackPanel Width="330">
                                    <TextBlock Text="진도 (예: 7-2, 전체 오답 복습)" FontSize="12" Foreground="#51627C"/>
                                    <TextBox x:Name="ProgressUnitInput"/>
                                </StackPanel>
                                <StackPanel Width="125">
                                    <TextBlock Text="진행 상태" FontSize="12" Foreground="#51627C"/>
                                    <ComboBox x:Name="ProgressStatusCombo"/>
                                </StackPanel>
                                <StackPanel Width="100">
                                    <TextBlock Text="범위 포함" FontSize="12" Foreground="#51627C"/>
                                    <CheckBox x:Name="ProgressScopeCheck" Content="시험범위" Margin="0,13,0,0" IsChecked="True"/>
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="저장" Click="SaveProgress_Click"/>
                                <Button Content="새 항목" Click="ClearProgress_Click"/>
                                <Button Content="선택 항목 삭제" Click="DeleteProgress_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="백업 · 가져오기">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28" MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="로컬 JSON 데이터 관리" FontSize="22" FontWeight="Bold" Foreground="#243351"/>
                        <TextBlock Text="Android·iOS StudyOne과 동일한 형식의 JSON을 사용합니다. 자동 클라우드 동기화는 아직 지원하지 않습니다."
                                   FontSize="13" Foreground="#63728C" Margin="0,8,0,22" TextWrapping="Wrap"/>
                        <TextBlock Text="일정 · 숙제 데이터" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="기존 StudyOne 전체 일정 백업(schema 1)과 호환됩니다. 가져오기는 현재 Windows 일정을 교체합니다."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <WrapPanel>
                            <Button Content="일정 JSON 내보내기" Click="ExportTasks_Click"/>
                            <Button Content="일정 JSON 가져오기" Click="ImportTasks_Click"/>
                        </WrapPanel>
                        <Separator Margin="0,24,0,24"/>
                        <TextBlock Text="교재 · 시험범위 진도" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Android·iOS의 StudyOne-progress.json 전용 형식과 호환됩니다. 가져오기는 현재 진도를 교체합니다."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <WrapPanel>
                            <Button Content="진도 JSON 내보내기" Click="ExportProgress_Click"/>
                            <Button Content="진도 JSON 가져오기" Click="ImportProgress_Click"/>
                        </WrapPanel>
                        <Separator Margin="0,24,0,24"/>
                        <TextBlock Text="일정별 학습 상세 정보" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Android·iOS와 호환되는 별도 studyone-task-details JSON입니다. 가져오기는 현재 Windows 학습 상세만 교체하고 이전 파일은 앱 내부에 백업합니다."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <WrapPanel>
                            <Button Content="학습 상세 JSON 내보내기" Click="ExportTaskDetails_Click"/>
                            <Button Content="학습 상세 JSON 가져오기" Click="ImportTaskDetails_Click"/>
                        </WrapPanel>
                        <Separator Margin="0,24,0,24"/>
                        <TextBlock Text="오답 관리 · 복습 기록" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Android·iOS 호환 studyone-wrong-answers JSON입니다. 수동 가져오기 전 기존 오답 원본을 별도 백업합니다."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <WrapPanel>
                            <Button Content="오답 JSON 내보내기" Click="ExportWrong_Click"/>
                            <Button Content="오답 JSON 가져오기" Click="ImportWrong_Click"/>
                        </WrapPanel>
                        <Separator Margin="0,24,0,24"/>
                        <TextBlock Text="보안 · 데이터 보존" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="현재 버전은 개발 프리뷰입니다. OpenAI·NEIS 키는 사용하거나 저장하지 않습니다. JSON 백업에는 개인 학습 기록이 있으므로 외부에 공유하지 마세요. 기기를 초기화하기 전 일정·진도 파일을 둘 다 보관하세요."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,15"/>
                        <TextBlock x:Name="DataPathText" Foreground="#4F6486" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="동기화 실험">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="StudyOne Sync · HTTPS 계정 연동 실험" FontSize="22"
                                   Foreground="#243351" FontWeight="Bold"/>
                        <Border Background="#FFF4DD" CornerRadius="12" Padding="14"
                                Margin="0,14,0,14">
                            <TextBlock TextWrapping="Wrap" FontSize="13"
                                       Foreground="#765724"
                                       Text="Canary 개발 기능입니다. 기존 로컬 서버 또는 사용자가 준비한 HTTPS 계정 서버를 수동 연결할 수 있습니다. 실제 클라우드 서비스는 아직 배포되지 않았습니다. 앱은 기기 토큰을 저장하지 않으며 사용자가 승인한 동작만 실행합니다."/>
                        </Border>
                        <TextBlock Text="서버 주소" FontWeight="SemiBold"/>
                        <TextBox x:Name="SyncUrlInput" Width="540"
                                 HorizontalAlignment="Left"
                                 Text="http://127.0.0.1:8765/"
                                 ToolTip="실제 원격 서버는 유효한 HTTPS 주소만 허용합니다."/>
                        <TextBlock Text="로컬 HTTP: 127.0.0.1:8765만 허용 · 원격 계정 서버: HTTPS 필수"
                                   FontSize="12" Foreground="#67758D" Margin="0,5,0,12"/>
                        <TextBlock Text="계정별 기기 Bearer 토큰 (저장하지 않음)" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="SyncTokenInput" Width="440"
                                     Height="38" Margin="0,8,0,14"
                                     HorizontalAlignment="Left"/>
                        <WrapPanel Margin="0,6,0,10">
                            <Button x:Name="SyncPreviewButton"
                                    Content="서버 기록 읽기 (전송 없음)"
                                    Click="SyncPreview_Click"/>
                            <Button x:Name="SyncUploadButton"
                                    Content="새 항목만 서버로 전송 · 확인 필수"
                                    Click="SyncUpload_Click"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="SyncPullTasksButton"
                                    Content="서버의 신규 일정만 가져오기 · 확인 필수"
                                    Click="SyncPullTasks_Click"/>
                            <Button x:Name="SyncPullProgressButton"
                                    Content="서버의 신규 진도만 가져오기 · 확인 필수"
                                    Click="SyncPullProgress_Click"/>
                        </WrapPanel>
                        <TextBlock Text="안전 정책" FontWeight="SemiBold" Margin="0,14,0,7"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#64748B"
                                   Text="기존 서버 ID는 수정하지 않고 신규 기록만 수동 업로드합니다. 서버에서 가져올 때도 로컬에 없는 ID만 사용자 승인 뒤 병합하며 기존 기록은 자동 덮어쓰거나 삭제하지 않습니다. 충돌 ID는 건너뜁니다. 변경사항 자동 실시간 반영·백그라운드 동기화는 이후 구현 대상입니다."/>
                        <Border Background="#F1F4FA" CornerRadius="12" Padding="16"
                                Margin="0,18,0,0">
                            <TextBlock x:Name="SyncResultText" Text="아직 연결하지 않았습니다."
                                       FontSize="13" Foreground="#284066" TextWrapping="Wrap"/>
                        </Border>
                        <Separator Margin="0,24,0,20"/>
                        <TextBlock Text="ChatGPT · AI 학습 계획 승인 대기함"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#243351"/>
                        <TextBlock Text="AI가 제안한 공부 계획은 앱에서 승인하기 전까지 실제 일정에 저장되지 않습니다. HTTPS 계정 서버와 읽기·쓰기 기기 토큰이 필요합니다."
                                   FontSize="12" Foreground="#63728C" Margin="0,7,0,12"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="SyncLoadPlansButton"
                                Content="서버의 승인 대기 계획 확인"
                                Click="SyncLoadPlans_Click" HorizontalAlignment="Left"/>
                        <ListBox x:Name="PendingPlansList" Height="140" Margin="0,12,0,8"
                                 DisplayMemberPath="Display"
                                 SelectionChanged="PendingPlansList_SelectionChanged"/>
                        <Border Background="#F5F7FC" CornerRadius="10" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230">
                                <TextBlock x:Name="PendingPlanDetailsText"
                                           Text="계획을 선택하면 과목·일정과 세부 공부를 확인할 수 있습니다."
                                           TextWrapping="Wrap" FontSize="13"
                                           Foreground="#3C4D6F"/>
                            </ScrollViewer>
                        </Border>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="SyncApprovePlanButton"
                                    Content="선택한 공부 계획 승인 · 실제 서버 일정 등록"
                                    Click="SyncApprovePlan_Click"/>
                            <Button x:Name="SyncRejectPlanButton"
                                    Content="선택한 계획 거부"
                                    Click="SyncRejectPlan_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
